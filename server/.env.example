PORT=5000
NODE_ENV=development

MONGO_URI=mongodb://localhost:27017/query-master

JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Local dev (frontend + backend on http://localhost, different ports): leave both as below.
# Production (frontend and backend on different domains, e.g. Vercel + Render, both https):
#   COOKIE_SECURE=true
#   COOKIE_SAMESITE=none
# sameSite=none is REJECTED by browsers unless secure=true, so the two must change together.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Must exactly match the deployed frontend origin (no trailing slash) — CORS with
# credentials:true does not accept a wildcard.
CLIENT_URL=http://localhost:5173

# The very first Super Admin account is created automatically on first boot — no manual
# seed step required. SUPER_ADMIN_EMAIL is required for this; SUPER_ADMIN_PASSWORD is
# optional — if you leave it unset, a strong random password is generated and printed to
# the server log exactly once, the moment the account is created. Safe to leave this
# whole block in place after first boot: it's a no-op once the account already exists.
SUPER_ADMIN_EMAIL=superadmin@querymaster.local
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Super Admin
